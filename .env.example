# ===================================================
# Tableau AI Insight Extension - Environment Config
# ===================================================

# Pilihan Provider: "gemini" atau "openai"
AI_PROVIDER=gemini

# API Key untuk Provider yang dipilih
# Jika gemini: masukkan Google AI Studio API Key (GEMINI_API_KEY)
# Jika openai: masukkan OpenAI API Key (OPENAI_API_KEY)
AI_API_KEY=your_gemini_or_openai_api_key_here

# Nama Model yang digunakan (Opsional, ada default fallback)
# Gemini contoh: gemini-3.5-flash-lite
# OpenAI contoh: gpt-4o-mini, gpt-4o
AI_MODEL=gemini-3.5-flash-lite

